
# File endings
*.xlsx
*.docx
*.pptx
.DS_Store

# Internal-only docs (not for the public repo)
Project_notes.md
.Rproj.user/
.Rhistory
.RData
.Ruserdata
Rplots.pdf

# Copyrighted reference PDFs -- keep locally, don't redistribute (repo is public)
Reproducibility_articles/

# Figures recreated in scripts
Figures/From_scripts/

# Generate content from .R scripts
Derived/*

# "Trust in science" addendum -- news-outlet stills + a private individual's photo, presented live but
# never pushed. Whole folder ignored so 02_slides.qmd (the tracked deck) stays fully reproducible
# without it: `quarto render` on a fresh clone never needs anything from here.
Local_addendum/

# Raw Google Forms export -- free-text answers could be identifying; only the categorized Pre_Workshop_Survey_public.csv is committed.
Data/Pre_Workshop_Survey.csv

# Depends on the gitignored raw xlsx, so it can't run for anyone who only has this repo -- kept local only.
Scripts/00a_wrangling.R

# Quarto render byproducts (recreate with `quarto render`)
Scripts/qmd/*.html
Scripts/qmd/*.pdf
Scripts/qmd/*_files/
Scripts/qmd/*_cache/
/.quarto/
