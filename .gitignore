*.xlsx
*.docx
.DS_Store

# Internal-only docs (not for the public repo)
Project_notes.md
.Rproj.user/
.Rhistory
.RData
.Ruserdata
Rplots.pdf

# Copyrighted reference PDFs -- keep locally, don't redistribute (repo is public)
Reproducibility_articles/

# Derived/ contents are recreatable and fully ignored; kept empty except for .gitkeep.
Derived/*
!Derived/.gitkeep

# Figures/ contents are recreatable too, but these are committed exceptions used directly in the slides.
Figures/*
!Figures/.gitkeep
!Figures/registrants_map.png
!Figures/survey_familiarity.png
!Figures/survey_goals.png

# Static asset (screenshot/diagram, not generated by a script) -- tracked like any other repo asset.
!Figures/SORTEE_3_goals.png

# Raw Google Forms export -- free-text answers could be identifying; only the categorized Pre_Workshop_Survey_public.csv is committed.
Data/Pre_Workshop_Survey.csv

# Depends on the gitignored raw xlsx, so it can't run for anyone who only has this repo -- kept local only.
Scripts/00a_wrangling.R

# Quarto render byproducts (recreate with `quarto render`)
Scripts/qmd/*.html
Scripts/qmd/*.pdf
Scripts/qmd/*_files/
Scripts/qmd/*_cache/
/.quarto/
